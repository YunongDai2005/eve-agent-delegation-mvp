---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	plan(plan)
	delegate(delegate)
	recover(recover)
	synthesize(synthesize)
	__end__([<p>__end__</p>]):::last
	__start__ --> plan;
	delegate -.-> recover;
	delegate -.-> synthesize;
	plan -.-> delegate;
	plan -.-> synthesize;
	recover -.-> delegate;
	recover -.-> synthesize;
	synthesize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
