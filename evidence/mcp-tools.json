[
  {
    "server": "gdacs",
    "tools": [
      {
        "name": "search_gdacs_events",
        "title": null,
        "description": "Search GDACS for ongoing or recent natural disaster events worldwide.\n\n    Use this when the user asks about current or recent disasters, hazards,\n    or emergencies \u2014 e.g. \"any active volcanoes right now\", \"is there\n    flooding in Bangladesh\", \"recent earthquakes near Japan\". The data comes\n    from the Global Disaster Alert and Coordination System (GDACS) and is\n    not limited to any one country.\n\n    Args:\n    eventlist: The type of hazard to search for. One of:\n        - \"EQ\": seismic events\n        - \"FL\": river/flash flooding\n        - \"VO\": volcanic eruptions or unrest\n        - \"WF\": forest/bush fires\n        - \"DR\": prolonged water shortage events\n        - \"TC\": hurricanes, typhoons, cyclones\n        - \"TS\": tsunami warnings/events\n        Leave unset to return any/all categories of hazard.\n    alertlevel: Optional severity filter. \"Green\" = low impact,\n        \"Orange\" = medium impact, \"Red\" = high impact/major disaster.\n        Leave unset to return events of any severity.\n    country: Optional country name to restrict results to\n        (e.g. \"Philippines\"). Leave unset to search globally.\n\n    Returns:\n        JSON string with matching events, including event name, country,\n        alert level, coordinates, and event date range.\n    ",
        "inputSchema": {
          "properties": {
            "eventlist": {
              "anyOf": [
                {
                  "enum": [
                    "EQ",
                    "TC",
                    "FL",
                    "VO",
                    "WF",
                    "DR",
                    "TS"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Eventlist"
            },
            "alertlevel": {
              "anyOf": [
                {
                  "enum": [
                    "Green",
                    "Orange",
                    "Red"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Alertlevel"
            },
            "country": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Country"
            }
          },
          "title": "search_gdacs_eventsArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "search_gdacs_eventsOutput",
          "type": "object"
        },
        "icons": null,
        "annotations": null,
        "meta": null,
        "execution": null
      }
    ]
  },
